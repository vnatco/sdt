{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shut Down Timer",
  "mainBinaryName": "shut-down-timer",
  "version": "0.1.0",
  "identifier": "co.vnat.sdt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shut Down Timer",
        "width": 588,
        "height": 616,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "menu",
        "title": "Shut Down Timer Menu",
        "width": 260,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Shut down, restart or sleep your computer on a timer",
    "longDescription": "A small timer that shuts down, restarts or puts your computer to sleep when time is up. It shrinks to a pill that floats on top of the screen while it counts down, and lives in the tray.",
    "license": "Apache-2.0",
    "publisher": "vnat.co",
    "homepage": "https://github.com/vnatco/sdt",
    "copyright": "Copyright 2026 Vladimer Natchkepia",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  }
}
